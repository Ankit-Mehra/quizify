# Test Environment Configuration
# Copy and customize from .env for testing

# Supabase Configuration (Use test project or same project with test data)
SUPABASE_URL=https://dqxzzyoqwaegdnwijgqn.supabase.co
SUPABASE_KEY=<YOUR_TEST_SUPABASE_ANON_KEY>

# Database Connection (for migrations and direct queries)
TEST_DATABASE_URL=postgresql://postgres.dqxzzyoqwaegdnwijgqn:QUizme%402026@aws-1-ca-central-1.pooler.supabase.com:6543/postgres

# OpenAI Configuration (Use test API key or mock)
OPENAI_API_KEY=<YOUR_TEST_OPENAI_KEY>

# Google AI Configuration (Use test API key or mock)
GOOGLE_AI_API_KEY=<YOUR_TEST_GOOGLE_KEY>

# Test-specific settings
TESTING=true
LOG_LEVEL=DEBUG

# Mock URLs for web scraping tests
MOCK_WEB_SCRAPING=false  # Set to true to use mocked responses instead of real web requests

# Test user credentials (for integration tests)
TEST_USER_EMAIL=test_user@example.com
TEST_USER_PASSWORD=TestPassword123!

# Rate limiting (relaxed for testing)
RATE_LIMIT_ENABLED=false

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
