# Environment variables for Quizify API

# ===================
# Supabase Configuration (REQUIRED)
# ===================
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_STORAGE_NAME=your_storage_bucket_name

# ===================
# AI Configuration (REQUIRED)
# ===================
OPENAI_API_KEY=your_openai_api_key

# ===================
# CORS Configuration (REQUIRED for Production)
# ===================
# JSON array of allowed origins for CORS
# Development example:
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Production example:
# BACKEND_CORS_ORIGINS=["https://quizify.ca","https://www.quizify.ca"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ===================
# Environment Mode (REQUIRED)
# ===================
# Set to "false" in production, "true" for development/testing
# When false: Disables /docs and /redoc endpoints for security
# When true: Enables API documentation at /docs and /redoc
TESTING=false

