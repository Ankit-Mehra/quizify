# Environment variables for Quizify API

# ===================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===================================
# Get these from your Supabase project settings
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_NAME=quiz-files

# ===================================
# AI CONFIGURATION (REQUIRED)
# ===================================
# OpenAI is used for quiz generation
OPENAI_API_KEY=your_openai_api_key

# Gemini API (Future support - not currently used)
# GEMINI_API_KEY=your_gemini_api_key

# ===================================
# SERVER CONFIGURATION (REQUIRED)
# ===================================
# JSON array of allowed origins for CORS
# Development example (include localhost variations for Postman testing):
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:8000"]
# Production example:
# BACKEND_CORS_ORIGINS=["https://quizify.ca","https://www.quizify.ca"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:8000"]

# ===================================
# OPERATIONAL MODE FLAGS (REQUIRED)
# ===================================
# TESTING: Set to "true" only when running unit tests with pytest
#   - true: Uses mocks, no real Supabase connection
#   - false: Uses real Supabase (default for dev/production)
TESTING=false

# DEVELOPMENT_MODE: Controls token exposure for API testing
#   - true: Returns auth tokens in response body (for Postman testing)
#   - false: Tokens only in HttpOnly cookies (production security)
DEVELOPMENT_MODE=true

# ENABLE_DOCS: Controls API documentation endpoints
#   - true: Shows /docs and /redoc endpoints (development)
#   - false: Hides documentation endpoints (production security)
ENABLE_DOCS=true

# ===================================
# OPTIONAL: Admin Fallback
# ===================================
# Only needed if you haven't set is_admin=true in profiles table
# Comma-separated list of Supabase user UUIDs with admin privileges
# ADMIN_USER_IDS=uuid-1,uuid-2,uuid-3

# ===================================
# OPTIONAL: Web Scraping Configuration
# ===================================
# User agent string for web scraping (URL quiz generation feature)
# Default: Mozilla/5.0 (compatible; QuizifyBot/1.0; +https://quizify.app/bot)
# Customize for your domain or deployment:
# SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; YourBotName/1.0; +https://yourdomain.com/bot)
# SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; QuizifyBot/1.0; +https://quizify.app/bot)


