# ============================================================================
# Environment variables for Quizify API
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control!
# ============================================================================

# ===================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===================================
# Get these from your Supabase project settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_NAME=quiz-files

# Supabase JWT Secret (REQUIRED for OAuth CSRF protection)
# Get from: Supabase Dashboard → Settings → API → JWT Secret
# Used for signing OAuth state tokens to prevent CSRF attacks
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ===================================
# URL CONFIGURATION (REQUIRED)
# ===================================
# Frontend URL - where your Next.js app is hosted
# Used for redirects after OAuth, email confirmation, password reset, etc.
# Development: http://localhost:3000
# Production: https://www.quizify.ca
FRONTEND_URL=http://localhost:3000

# Backend URL - where this FastAPI server is hosted
# Used for OAuth callback URLs (Google redirects back here)
# Development: http://localhost:8000
# Production: https://api.quizify.ca
BACKEND_URL=http://localhost:8000

# Cookie domain for cross-subdomain authentication
# Must start with '.' to work across subdomains (www, api, etc.)
# Development: Leave empty or don't set (localhost doesn't need domain)
# Production: .quizify.ca (note the leading dot)
# COOKIE_DOMAIN=.quizify.ca

# ===================================
# AI CONFIGURATION (REQUIRED)
# ===================================
# OpenAI is used for quiz generation
OPENAI_API_KEY=your_openai_api_key

# Gemini API (Future support - not currently used)
# GEMINI_API_KEY=your_gemini_api_key

# ===================================
# SERVER CONFIGURATION (REQUIRED)
# ===================================
# JSON array of allowed origins for CORS
# Development example (include localhost variations for Postman testing):
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:8000"]
# Production example:
# BACKEND_CORS_ORIGINS=["https://quizify.ca","https://www.quizify.ca"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:8000"]

# BACKEND_CORS_ORIGIN_REGEX: Optional regex pattern for wildcard origin matching
# Useful for dynamic origins like Vercel preview deployments
# SECURITY WARNING: Be specific with your regex pattern to avoid overly permissive CORS
# Good example (Vercel previews only): ^https://.*\.vercel\.app$
# Bad example (too permissive): .* or https?://.*
# Leave commented out for production unless you need dynamic origin support
# BACKEND_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ===================================
# OPERATIONAL MODE FLAGS (REQUIRED)
# ===================================
# TESTING: Set to "true" only when running unit tests with pytest
#   - true: Uses mocks, no real Supabase connection
#   - false: Uses real Supabase (default for dev/production)
TESTING=false

# DEVELOPMENT_MODE: Controls token exposure for API testing
#   - true: Returns auth tokens in response body (for Postman testing)
#   - false: Tokens only in HttpOnly cookies (production security)
DEVELOPMENT_MODE=true

# ENABLE_DOCS: Controls API documentation endpoints
#   - true: Shows /docs and /redoc endpoints (development)
#   - false: Hides documentation endpoints (production security)
ENABLE_DOCS=true

# ===================================
# ADMIN CONFIGURATION (OPTIONAL)
# ===================================
# Only needed if you haven't set is_admin=true in profiles table
# Comma-separated list of Supabase user UUIDs with admin privileges
# ADMIN_USER_IDS=uuid-1,uuid-2,uuid-3

# ===================================
# WEB SCRAPING CONFIGURATION (OPTIONAL)
# ===================================
# User agent string for web scraping (URL quiz generation feature)
# Default: Mozilla/5.0 (compatible; QuizifyBot/1.0; +https://quizify.app/bot)
# Customize for your domain or deployment:
# SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; YourBotName/1.0; +https://yourdomain.com/bot)

# ============================================================================
# REDIS CONFIGURATION (REQUIRED FOR PRODUCTION)
# ============================================================================
# Redis is used for distributed state management: sessions, caching, browser slots
# Railway provides REDIS_URL automatically when you add a Redis service

# Main connection URL (provided by Railway Redis service)
# Format: redis://default:PASSWORD@redis.railway.internal:6379
# Development: redis://localhost:6379 (or use Docker: docker run -p 6379:6379 redis)
REDIS_URL=redis://localhost:6379

# Feature flag to enable/disable Redis (default: true)
# Set to false to run without Redis (limited to single instance, no session management)
REDIS_ENABLED=true

# Connection pool settings (tune for your workload)
# REDIS_MAX_CONNECTIONS=20
# REDIS_SOCKET_TIMEOUT=5
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_HEALTH_CHECK_INTERVAL=30

# Cache TTL settings in seconds (tune based on data freshness needs)
# REDIS_CACHE_TTL_USER_TIER=300          # 5 minutes - user tier/quota info
# REDIS_CACHE_TTL_QUIZ_METADATA=1800     # 30 minutes - quiz metadata
# REDIS_CACHE_TTL_QUIZ_QUESTIONS=3600    # 1 hour - quiz questions
# REDIS_CACHE_TTL_SUBMISSIONS=600        # 10 minutes - quiz submissions

# Browser slot settings (for URL scraping feature)
# REDIS_BROWSER_SLOT_TTL=300             # 5 minutes - browser slot reservation
# REDIS_LOCK_TTL=30                      # 30 seconds - distributed lock timeout
# MAX_CONCURRENT_BROWSERS=3              # Max concurrent browser instances per user

# Session settings
# REDIS_SESSION_TTL=2592000              # 30 days - session expiry (aligned with refresh token)
# MAX_SESSIONS_PER_USER=5                # Max active sessions per user

# IP Hash Secret (REQUIRED for session security)
# Used to hash IP addresses for session tracking without storing raw IPs
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SECRET=your_ip_hash_secret_here

# ============================================================================
# STRIPE CONFIGURATION (REQUIRED FOR BILLING)
# ============================================================================
# Stripe API keys from Stripe Dashboard (https://dashboard.stripe.com/apikeys)
# SECURITY WARNING: Never commit these keys to version control
# Use test keys (sk_test_...) in development, live keys (sk_live_...) in production

# Stripe Secret Key - used for server-side API calls
# Test key starts with: sk_test_
# Live key starts with: sk_live_
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Stripe Publishable Key - used by frontend for Checkout/Elements
# Test key starts with: pk_test_
# Live key starts with: pk_live_
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe Webhook Secret - verifies webhook signatures from Stripe
# Get this when you create a webhook endpoint in Stripe Dashboard
# Starts with: whsec_
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===================================
# Stripe Price IDs (create in Stripe Dashboard → Products)
# ===================================

# Pro Plan Price ID ($20/month - 40 credits = 80 units)
# STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id

# Premium Plan Price ID (Legacy - kept for backward compatibility)
# STRIPE_PRICE_ID_PREMIUM=price_your_premium_plan_price_id

# Credit Pack Price IDs (one-time purchases)
# These are for users who want to buy credits without a subscription
# STRIPE_PRICE_ID_CREDITS_5=price_5_credits_price_id     # $5 - 5 credits (10 units)
# STRIPE_PRICE_ID_CREDITS_10=price_10_credits_price_id   # $10 - 10 credits (20 units)
# STRIPE_PRICE_ID_CREDITS_15=price_15_credits_price_id   # $15 - 15 credits (30 units)

# ===================================
# Stripe Redirect URLs (after checkout)
# ===================================
# These default to FRONTEND_URL + path if not set
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
# STRIPE_CANCEL_URL=http://localhost:3000/billing

# Backend webhook endpoint path (usually leave as default)
# STRIPE_WEBHOOK_ENDPOINT=/api/billing/webhook

# Billing strict mode - when True, webhooks fail if Redis is unavailable
# Set to "true" in production with multiple instances to prevent duplicate processing
# BILLING_REQUIRE_REDIS=false

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (for Google Forms Export - Pro Tier Feature)
# ============================================================================
# Required for Google Sign-In authentication and Google Forms export feature
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable these APIs:
#   - Google Forms API: https://console.cloud.google.com/apis/library/forms.googleapis.com
#   - Google Drive API: https://console.cloud.google.com/apis/library/drive.googleapis.com

# Google OAuth Client ID (from Google Cloud Console)
# Format: xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google OAuth Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth redirect URI (must match Google Cloud Console configuration exactly)
# Development: http://localhost:8000/api/auth/google/callback
# Production: https://api.quizify.ca/api/auth/google/callback
# This is for Google Forms export OAuth, NOT Google Sign-In (which uses Supabase)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Encryption key for Google OAuth refresh tokens (CRITICAL for production!)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If not set, tokens will be stored in PLAINTEXT (major security risk!)
# If you change this key, all existing tokens will become invalid
GOOGLE_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# ============================================================================
# CRON JOB CONFIGURATION (REQUIRED FOR SCHEDULED TASKS)
# ============================================================================
# API key for authenticating cron job requests (Railway cron, etc.)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Used by /api/cron/* endpoints for monthly credit resets, cleanup tasks, etc.
CRON_API_KEY=your_cron_api_key_here

# ============================================================================
# RESEND CONFIGURATION (for Contact Form Emails)
# ============================================================================
# Resend is used to send contact form submissions to admin
# Get your API key at: https://resend.com/api-keys

# Resend API Key (starts with re_)
# RESEND_API_KEY=re_your_resend_api_key_here

# Email address to receive contact form submissions
# CONTACT_EMAIL=admin@quizify.ca

# ============================================================================
# POSTHOG LLM ANALYTICS (OPTIONAL)
# ============================================================================
# PostHog tracks AI generation metrics: token usage, latency, cost estimates
# Useful for monitoring AI costs and performance
# Get your API key from: https://app.posthog.com/project/settings

# PostHog Project API Key (starts with phc_)
# POSTHOG_API_KEY=phc_your_project_api_key_here

# PostHog instance URL (default: US Cloud)
# Use https://eu.i.posthog.com for EU Cloud
# POSTHOG_HOST=https://us.i.posthog.com

# Enable/disable LLM analytics (default: true when API key is set)
# Set to false to disable tracking without removing the API key
# POSTHOG_LLM_ANALYTICS_ENABLED=true

# ============================================================================
# QUIZ QUALITY / RAG CONFIGURATION (OPTIONAL - Advanced)
# ============================================================================
# These control the RAG (Retrieval-Augmented Generation) pipeline
# for improved quiz question quality. Defaults are optimized for most use cases.

# LlamaIndex embedding configuration
# EMBEDDING_MODEL=text-embedding-3-small    # OpenAI embedding model
# EMBEDDING_DIMENSIONS=1536                  # Embedding vector dimensions
# CHUNK_SIZE=512                             # Document chunk size for indexing
# CHUNK_OVERLAP=50                           # Overlap between chunks

# Quality feature flags (all default to true)
# ENABLE_RAG_PIPELINE=true                   # Use RAG for context-aware generation
# ENABLE_CONCEPT_EXTRACTION=true             # Extract key concepts from content
# ENABLE_BLOOM_CLASSIFICATION=true           # Classify questions by Bloom's taxonomy
# ENABLE_FACT_CHECK=true                     # Verify generated questions against source

# Performance limits
# MAX_CHUNKS_PER_DOCUMENT=100                # Max chunks to index per document
# MAX_CONCEPTS_PER_DOCUMENT=50               # Max concepts to extract
# EMBEDDING_BATCH_SIZE=20                    # Batch size for embedding API calls
