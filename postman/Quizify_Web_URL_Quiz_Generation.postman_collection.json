									"    pm.expect(jsonData).to.have.property('generation_stats');",
									"    pm.environment.set(\"enhanced_quiz_id\", jsonData.quiz_id);",
									"});",
									"",
									"pm.test(\"Questions have Bloom's taxonomy\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.questions && jsonData.questions.length > 0) {",
									"        var q = jsonData.questions[0];",
									"        pm.expect(q).to.have.property('bloom_level');",
									"        pm.expect(q).to.have.property('difficulty');",
									"    }",
									"});",
									"",
									"pm.test(\"Questions have explanations\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.questions && jsonData.questions.length > 0) {",
									"        pm.expect(jsonData.questions[0]).to.have.property('explanation');",
									"    }",
									"});"
								],
