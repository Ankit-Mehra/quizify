{
  "info": {
    "name": "Quizify Auth API",
    "description": "Authentication endpoints for user signup, login, logout, email verification, and account management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup - New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"User created successfully\", function () {",
              "    const response = pm.response.json();",
              "    ",
              "    // Debug: Log the response",
              "    console.log('Response:', JSON.stringify(response));",
              "    ",
              "    pm.expect(response.message).to.include('successfully');",
              "    pm.expect(response).to.have.property('user_id');",
              "    ",
              "    // Save user_id for later tests - now with debug logging",
              "    const userId = response.user_id;",
              "    console.log('User ID to save:', userId);",
              "    ",
              "    if (userId) {",
              "        pm.environment.set('new_user_id', userId);",
              "        console.log('✅ Saved new_user_id to environment:', userId);",
              "    } else {",
              "        console.error('❌ user_id is falsy:', userId);",
              "    }",
              "    ",
              "    // Verify it was saved",
              "    const saved = pm.environment.get('new_user_id');",
              "    console.log('Verification - Retrieved from environment:', saved);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"name\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "description": "Create a new user account. Email must be unique. Password should be at least 8 characters."
      },
      "response": []
    },
    {
      "name": "2. Login - Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Login successful\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.include('logged in');",
              "    pm.expect(response).to.have.property('user');",
              "    pm.expect(response.user).to.have.property('id');",
              "    pm.expect(response.user).to.have.property('email');",
              "    ",
              "    // In test mode, access_token is returned in body",
              "    if (response.access_token) {",
              "        pm.environment.set('auth_token', response.access_token);",
              "        console.log('Auth token saved to environment');",
              "    }",
              "    ",
              "    // Save logged in user ID",
              "    if (response.user.id) {",
              "        pm.environment.set('current_user_id', response.user.id);",
              "    }",
              "});",
              "",
              "pm.test(\"Cookies are set\", function () {",
              "    pm.expect(pm.cookies.has('quizify_access_token')).to.be.true;",
              "    pm.expect(pm.cookies.has('quizify_refresh_token')).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Login with email and password. Returns JWT token in response body (test mode) and sets HttpOnly cookies."
      },
      "response": []
    },
    {
      "name": "3. Change Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Password updated successfully\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.include('updated');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"new_password\": \"NewSecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/change-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "change-password"
          ]
        },
        "description": "Change user password. Requires authentication. User must be logged in."
      },
      "response": []
    },
    {
      "name": "4. Get Current User Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User info has all required fields\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('user_id');",
              "    pm.expect(response).to.have.property('email');",
              "    pm.expect(response).to.have.property('account_tier');",
              "    pm.expect(response).to.have.property('role');",
              "    pm.expect(response).to.have.property('current_quiz_count');",
              "    pm.expect(response).to.have.property('quota_limit');",
              "    pm.expect(response).to.have.property('quota_exceeded');",
              "});",
              "",
              "pm.test(\"Tier and quota information present\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(['free', 'basic', 'educator']).to.include(response.account_tier);",
              "    pm.expect(response.quota_limit).to.be.a('number');",
              "    pm.expect(response.current_quiz_count).to.be.a('number');",
              "    pm.expect(response.quota_exceeded).to.be.a('boolean');",
              "    ",
              "    console.log('User Tier: ' + response.account_tier);",
              "    console.log('Quiz Quota: ' + response.current_quiz_count + '/' + response.quota_limit);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "Get current authenticated user's information including tier, role, and quota.\n\n**Returns:**\n- user_id: UUID of the user\n- email: User's email address\n- account_tier: free/basic/educator\n- role: user/moderator/admin\n- current_quiz_count: Number of quizzes created\n- quota_limit: Maximum quizzes allowed for tier\n- quota_exceeded: Boolean if quota is exceeded\n- created_at: Account creation timestamp\n\n**Quota Limits by Tier:**\n- Free: 5 quizzes\n- Basic: 100 quizzes\n- Educator: 500 quizzes"
      },
      "response": []
    },
    {
      "name": "5. Update Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Email updated successfully\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.include('initiated');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_email\": \"newemail@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/update-email",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "update-email"
          ]
        },
        "description": "Update user's email address. Requires authentication.\n\nIMPORTANT: Secure Email Change is enabled in Supabase.\nYou will receive TWO confirmation emails:\n1. First to your NEW email address - click to confirm\n2. Then to your CURRENT email address - click to confirm\nBoth confirmations are required to complete the email change."
      },
      "response": []
    },
    {
      "name": "6. Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Logout successful\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.include('logged out');",
              "});",
              "",
              "// Clear auth token from environment",
              "pm.environment.unset('auth_token');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        },
        "description": "Logout user and clear authentication cookies. Requires authentication."
      },
      "response": []
    },
