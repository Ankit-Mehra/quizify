            "admin",
            "users",
            "{{test_user_id}}"
          ]
        },
        "description": "Get detailed information about a specific user by ID."
      },
      "response": []
    },
    {
      "name": "3. Update Tier: Free \u2192 Basic",
      "event": [
        {
          "listen": "test",
