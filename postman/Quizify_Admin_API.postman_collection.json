            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_tier\": \"basic\",\n  \"reason\": \"Postman API test - upgrading to basic tier\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/admin/users/{{test_user_id}}/tier",
