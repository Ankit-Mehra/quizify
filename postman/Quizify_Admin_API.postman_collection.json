{
  "info": {
    "name": "Quizify Admin API",
    "description": "Admin endpoints for user tier management and RBAC (Role-Based Access Control)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. List All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Users have required fields\", function () {",
              "    const users = pm.response.json();",
              "    if (users.length > 0) {",
              "        const user = users[0];",
              "        pm.expect(user).to.have.property('id');",
              "        pm.expect(user).to.have.property('email');",
              "        pm.expect(user).to.have.property('account_tier');",
              "        pm.expect(user).to.have.property('role');",
              "        pm.expect(user).to.have.property('current_quiz_count');",
              "        pm.expect(user).to.have.property('quota_limit');",
              "        ",
              "        // Save first non-admin user ID for later tests",
              "        if (user.role === 'user' && !pm.environment.get('test_user_id')) {",
              "            pm.environment.set('test_user_id', user.id);",
              "            console.log('Saved test_user_id:', user.id);",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/users?limit=10&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        },
        "description": "Get all users with tier and role information. Supports pagination."
      },
      "response": []
    },
