				{
					"name": "User A - Slot 4 (Should FAIL - Quota Exceeded)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 429 (Too Many Requests)\", function () {",
									"    pm.expect(pm.response.code).to.eql(429);",
									"});",
									"",
									"pm.test(\"Error message mentions browser limit\", function () {",
									"    var jsonData = pm.response.json();",
									"    var errorMsg = JSON.stringify(jsonData).toLowerCase();",
									"    pm.expect(errorMsg).to.include('browser');",
									"});",
									"",
									"console.log(\"Testing: User A attempts slot 4 (OVER LIMIT)\");",
									"console.log(\"Expected: ❌ REJECTION - HTTP 429\");",
									"console.log(\"Result: Status \" + pm.response.code);",
									"",
									"if (pm.response.code === 429) {",
									"    console.log(\"✅ PASS: Quota enforcement working!\");",
									"    console.log(\"   User A correctly blocked at 3/3 slots\");",
									"    console.log(\"   Error:\", pm.response.json().detail || pm.response.json().message);",
									"} else {",
									"    console.log(\"❌ FAIL: Quota not enforced (allowed 4th slot)\");",
									"}",
									"",
									"console.log(\"=\".repeat(70));",
									"console.log(\"📊 SCENARIO 1 COMPLETE: Single User Quota\");",
									"console.log(\"   Slots 1-3: ✅ Acquired successfully\");",
									"console.log(\"   Slot 4:    ❌ Rejected (as expected)\");",
									"console.log(\"   Verdict:   Browser slot limit working correctly\");",
									"console.log(\"=\".repeat(70));",
									"console.log(\"\");"
								],
