									"    console.log(\"   Previous slots were released via TTL\");",
									"    console.log(\"   Automatic cleanup working correctly!\");",
									"} else if (pm.response.code === 429) {",
									"    console.log(\"⏳ PENDING: Slots not yet released\");",
