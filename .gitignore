# Python virtual environments
venv/
.venv/
env/
ENV/
venv.bak/
.venv.bak/
env.bak/

# Python cache and compiled files
__pycache__/
*.py[cod]
*.so
.Python

# Python packaging and build output
*.egg-info/
*.egg
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/

# Local database files and SQLite journals/WAL files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local environment variables; keep sanitized templates versioned
.env
.env.*
*.env
!.env.example
!.env.*.example
!.env.sample
!.env.template

# OS-specific files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Local editor state; allow portable shared VS Code configuration
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Tool caches and notebook checkpoints (not notebook source files)
.cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json
.ipynb_checkpoints/

# Testing and coverage output
.pytest_cache/
.hypothesis/
.benchmarks/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
/coverage.xml
/coverage.json
/junit*.xml
/nosetests.xml
*.cover
*.py,cover

# Playwright-generated reports and artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs, including rotated logs outside the logs directory
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files and editor/merge backups
*.tmp
*.temp
*.bak
*.orig
*.rej

# Generated by scripts/create-production-archive.sh.
# Do not ignore all archives: source assets and test fixtures may use them.
/deploy-archives/

# Keep .dockerignore, dependency lockfiles (including uv.lock), environment
# templates, documentation/specs, tests, migrations, and shared tooling tracked.
